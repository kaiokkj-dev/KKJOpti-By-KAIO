{
  "name": "kkjopti",
  "version": "2.0.0",
  "description": "Painel transparente e seguro de otimização para Windows",
  "author": "Kaio",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "lucide": "1.39.0"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "24.13.3"
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "build": {
    "appId": "com.kaio.kkjopti",
    "productName": "KKJOpti",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "optimizations.js",
      "system-state.js",
      "index.html",
      "style.css",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.bat",
          "**/*.cmd",
          "**/*.reg"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/kkjopti_icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/kkjopti_icon.ico",
      "uninstallerIcon": "assets/kkjopti_icon.ico"
    }
  }
}
